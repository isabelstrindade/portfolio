# Normalização de quebras de linha automáticas
* text=auto eol=lf

# Arquivos de código e marcação
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binários e imagens
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp4 binary
